; CLI 设置（可选）。复制为 cli.ini 后生效；--cli-config 可指定其它路径。
;
; [editor]
; external = code --wait   ; Ctrl+G 使用的外部编辑器
;                          ; 优先级：--editor > 本项 > $AIAGENT_EDITOR > $VISUAL > $EDITOR

[editor]
external = nano

; UI 外观（可用 CLI 内 /theme 切换并写回本文件）
[ui]
; dark | light
theme = dark
; 需要安装 Nerd Font；也可用环境变量 DE_NERD_FONT=1
nerd_font = false

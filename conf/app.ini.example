[deepseek]
api_key = your-deepseek-api-key
base_url = https://api.deepseek.com
model = deepseek-v4-flash
reasoning_model = deepseek-v4-pro
; 非流式请求的总超时；流式请求按空闲超时处理：持续收到 token 时单次请求
; 可以超过该值（长代码生成不会被 60s 掐断），连续这么久没有数据才中断。
timeout_seconds = 60
max_retries = 3

[mcp]
; M3 使用；不填时 aiagent_app 会尝试 vendor 下的本地构建。
; Linux 示例：
;   binary = /absolute/path/to/mcp_server/mcp_server
;   plugins = /absolute/path/to/mcp_server/plugins
;   python_path = python3
; Windows 示例（反斜杠需写成 \\，或直接用正斜杠）：
;   binary = C:/Tools/mcp/mcp_server.exe
;   plugins = C:/Tools/mcp/plugins
;   python_path = python
; python_path 留空/注释时使用平台默认（Linux python3 / Windows python）。
; python_path =
; 留空 = 自动发现安装包/源码树内的 MCP；需要固定路径时再填。
binary =
plugins =
transport = stdio
request_timeout_seconds = 60

[logging]
level = info
file = .runtime/backend.log
console = false
max_size_bytes = 10485760
max_files = 5

[compaction]
; 上下文压缩：当请求 token 超过「生效阈值」时，把较早的消息压缩成结构化摘要，
; 只保留最近 keep_recent_tokens。
;
; 生效阈值 = context_window - reserve_tokens（compact_at_tokens=0 时）；
; 若填了 compact_at_tokens，则取 min(compact_at_tokens, context_window - reserve_tokens)，
; 即软阈值只允许比硬线更早触发。
;
; context_window 必须填模型真实窗口（deepseek-flash / deepseek-v4-pro 为 1000000）。
; 实测：单轮耗时由「这一轮思考/输出多少」主导，与上下文大小关系很弱；反而压缩会
; 打破前缀缓存（cacheRead 单价约为 input 的 1/50）并丢掉上下文，所以要压得尽量少。
enabled = true
context_window = 1000000
; 给「一次输出 + 摘要」预留的空间（模型单次输出上限 384000，这里取一半）。
reserve_tokens = 200000
; 独立软阈值：0 = 只用「窗口 - 预留」（默认，触发线 80 万）；
; 想「每轮更轻」可显式调小（如 300000），代价是更早丢上下文。
compact_at_tokens = 0
; 压缩后保留的最近上下文（本地估算口径：UTF-8 字节 / 3）。
; 必须显著小于生效阈值，否则会退化成"压完只剩两三轮余量、每轮都要再压"
; （启动时会检查并夹到阈值的 1/3，日志里给出 warning）。
keep_recent_tokens = 60000
; 压缩收益下限：压完至少降低这个比例才提交，否则保持原历史并记录
; event=compaction_skipped reason=low_gain；0 表示不做收益判断。
min_gain_ratio = 0.3

[instructions]
; 终端 Agent 是否自动加载工作目录相关的 AGENTS.md。
agents_md = true
agents_md_file_name = AGENTS.md
; 同目录存在 override 时压制 AGENTS.md；留空 = 关闭 override。
agents_md_override_file_name = AGENTS.override.md
; primary/override 都缺失时，是否回退读取 CLAUDE.md / CLAUDE.MD。
; 默认关闭：同时存在 AGENTS.md 与 CLAUDE.md 的仓库容易重复注入。
agents_md_claude_fallback = false
; 是否向祖先目录查找；找到 .git 根后停止。
agents_md_search_parents = true
; 最多加载多少个文件。
agents_md_max_files = 8
; 单个文件与全部项目指令的最大字节数。
agents_md_max_file_bytes = 16384
agents_md_max_total_bytes = 32768
; 默认不跟随符号链接。
agents_md_follow_symlinks = false
; 没有 .git 根时最多向上查找的层数。
agents_md_max_depth = 16

[prompt]
; 用户级系统提示词覆盖。留空 = 使用内置动态提示词（按本次工具集生成）。
; system_prompt_file 非空时替换基础 preamble/tools/rules；项目指令、技能、
; 环境与派发准则仍由运行时追加。相对路径相对本配置文件所在目录解析。
system_prompt_file =
; 非空时作为 <addendum> 追加到基础提示词后、项目指令前。
append_system_prompt_file =
; 非空时注入 <harness_docs>，列出 <root>/README.md 与 <root>/docs；
; 只在用户询问 harness 本身（配置/权限/技能/MCP/打包/SDK）时读取。
; 相对路径相对本配置文件所在目录解析；留空 = 不注入。
harness_docs_root =
; 两个提示词文件的字节上限；超过直接报错，避免半截提示词上线。
max_system_prompt_bytes = 32768

[skills]
; 技能加载：从 <root>/<skill>/SKILL.md 发现技能。系统提示只注入
; name/description；正文由只读工具 skill 按需加载。
enabled = true
; 项目级：<project-root>/.de/skills；project-root 取最近 .git，找不到时用 cwd。
project = true
; 用户级：<data_dir>/skills（默认 ~/.de/skills）。
user = true
; 内置：<share>/skills，源码树回退 skills/。
builtin = true
; 额外根，逗号分隔；相对路径相对当前工作目录。可用来显式接入 .claude/skills。
extra_roots =
; 目录规模上限；超出后截断并写日志。
max_skills = 64
max_catalog_bytes = 8192
; 单次加载正文/资源文件的上限；超出截断并提示原文件路径。
max_skill_bytes = 65536
; 是否跟随技能目录与 SKILL.md 的符号链接。
follow_symlinks = false

[tools]
; 文件工具（read/write/edit）沙箱：默认只允许访问本次请求的工作目录
; 及其子目录，`../`、绝对路径与指向外部的符号链接都会被拒绝。
; 需要额外放行的目录用逗号分隔（相对路径相对工作目录解析）。
; 注意：bash 工具本身不受该限制。
; 设为 false 可完全关闭沙箱（不推荐）。
sandbox_enabled = true
sandbox_roots =

[review]
; 代码审核 Agent：独立 reviewer 会话 + review pack/report 文件契约。
; 语义见 docs/planning/agent/代码审核Agent规划.md。
enabled = true
; 审核产物目录；相对工作目录，必须是仓库内相对路径（拒绝 ..）。
dir = docs/review
; pack 上限。
max_diff_bytes = 2097152
max_file_bytes = 262144
max_untracked_bytes = 524288
max_files = 500
; 用户消息摘录与报告上限。
session_excerpt_bytes = 16384
max_report_bytes = 1048576
; 空 = 继承父模型（P2 才真正使用）。
model =
; 受限验证：只执行 pack/项目配置声明的 argv；默认开启。
verify_enabled = true
verify_timeout_s = 900
verify_output_bytes = 32768
; in_place = 当前工作区执行；copy = git worktree 临时副本执行（P1）。
; copy 会把 working-tree diff 与 untracked 文件叠加到副本，测试改副本不会影响
; 原工作区；含 submodule 的仓库暂不支持 copy，会明确报错。
verify_mode = in_place
; 长任务：单次 review 总预算、工具轮次、分块与 checkpoint。
max_tool_rounds = 128
review_timeout_s = 3600
; P1 受控分片：0 关闭 review_scout；1–4 为只读 scout 并发上限。
scout_max = 0
checkpoint = true
draft_report = true
chunk_files = 20
chunk_diff_bytes = 262144
; 后台队列（P1）：true 时 de review --background 可用。
; 同一仓库并发 1 个、排队上限 4；同 repo+feature+branch 新任务顶掉旧任务。
background_enabled = false
max_concurrent_jobs = 1
max_queued_jobs = 4
supersede_policy = latest

[agents]
; 多 Agent 协同：父 Agent 可用 task 工具把自包含子任务派给子 Agent（独立上下文，
; 只回传压缩后的结果）。规划与语义见 docs/planning/agent/多Agent协同规划.md。
; 内置两个定义：general（继承父工具集）与 explorer（只读 read/grep/glob/ls）；
; 提示词从 <share>/prompts 或源码树 prompts/ 读取，找不到会直接报错（不做静默降级）。
enabled = true
; 派生深度：0 = 关闭（不注册 task 工具）；1 = 子 Agent 不能再派生；最大 4。
max_depth = 1
; 同时运行的子 Agent 上限（含一次批量扇出）。
max_concurrent = 3
; 后台任务的并发上限（0 = 关闭 task(background=true)）。后台任务与前台共享
; max_concurrent 总闸门，这里限制"已受理但未收敛"的数量，超限直接拒绝、不排队。
max_background = 2
; 单个子 Agent 的硬超时（秒）；task 参数 timeout_s 可逐次覆盖。
; 实测：默认给太大时粒度过粗的子任务会漫游到接近上限（300s 批次实测 280s 返回），
; 所以默认收紧到 120。
default_timeout_s = 120
; 子 Agent 工具循环轮次上限（防跑飞）。
max_rounds = 16
; 单条结果回传父上下文的上限（字符，头尾保留式截断）。
result_max_chars = 8000
; 子 Agent 的事件是否实时进入父会话流（false = 只回传最终结果，更安静）。
stream_events = true
; 子 Agent 默认模型；留空 = 继承父模型（可填 deepseek-v4-flash 降本）。
default_model =

; 覆盖 / 追加单个定义（名字与内置定义同名时覆盖其字段）。
; [agents.explorer]
; description = Read-only codebase exploration.
; system_prompt_file = prompts/explorer.md
; tools = read,grep,glob,ls
; model = deepseek-v4-flash

; 顶层审核用 [review] + prompts/reviewer.md；需要进程内审核子 Agent 时，
; 自行定义 [agents.<name>] 并指向独立提示词文件，避免与顶层 reviewer 复用同一份
; 工具集语义。

[storage]
; 用户级数据目录（权限等与用户相关的状态）。
; Linux 留空：DE_HOME > XDG_DATA_HOME/de > ~/.de。
; Windows 留空：DE_HOME > XDG_DATA_HOME/de > %USERPROFILE%\.de > %LOCALAPPDATA%\de。
; 目录按需创建。
data_dir =
; 权限文件；留空时用 <data_dir>/permissions.json。
permissions_file =
; bash 命令白/黑名单文件；留空时用 <data_dir>/bash_policy.rules。
; 文件不存在时会自动生成一份带注释的默认规则，用户可直接编辑。
bash_policy_file =
; 项目信任文件；留空时用 <data_dir>/trust.json。
trust_file =

[permissions]
; 新路径（未单独配置）时的默认模式：confirm | workspace | full。
; 注意：confirm 的“逐次确认”通道尚未实现（M3），当前会先拒绝写/命令并提示。
default_mode = confirm
; 允许设置的最高模式；full 之外的档位不会被它限制。
max_mode = full
; 非交互调用方（A2A / 同步接口）允许的最高档位，且永远不会拿到 full。
non_interactive_max_mode = workspace
; 是否允许设置 full（false 时 full 会被夹到 workspace）。
allow_full_access = true
; 逐次确认的超时秒数（1..3600，越界直接报配置错误）；超时按拒绝处理。
; 无审批人的调用方（脚本/CI）：同步接口 POST /api/v1/chat 走非交互路径、立即拒绝；
; 流式接口会等满这里的秒数，必要时改用同步接口，或把该路径设为 workspace/full。
approval_timeout_seconds = 120

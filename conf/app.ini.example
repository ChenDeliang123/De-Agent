[deepseek]
api_key = your-deepseek-api-key
base_url = https://api.deepseek.com
model = deepseek-v4-flash
reasoning_model = deepseek-v4-pro
timeout_seconds = 60
max_retries = 3

[mcp]
; M3 使用；不填时 aiagent_app 会尝试 vendor 下的本地构建。
binary = /absolute/path/to/mcp_server/mcp_server
plugins = /absolute/path/to/mcp_server/plugins
python_path = python3
transport = stdio
request_timeout_seconds = 60

[logging]
level = info
file = .runtime/backend.log
console = false
max_size_bytes = 10485760
max_files = 5

[compaction]
; 上下文压缩：当请求 token 超过「生效阈值」时，把较早的消息压缩成结构化摘要，
; 只保留最近 keep_recent_tokens。
;
; 生效阈值 = context_window - reserve_tokens（compact_at_tokens=0 时）；
; 若填了 compact_at_tokens，则取 min(compact_at_tokens, context_window - reserve_tokens)，
; 即软阈值只允许比硬线更早触发。
;
; context_window 必须填模型真实窗口（deepseek-flash / deepseek-v4-pro 为 1000000）。
; 实测：单轮耗时由「这一轮思考/输出多少」主导，与上下文大小关系很弱；反而压缩会
; 打破前缀缓存（cacheRead 单价约为 input 的 1/50）并丢掉上下文，所以要压得尽量少。
enabled = true
context_window = 1000000
; 给「一次输出 + 摘要」预留的空间（模型单次输出上限 384000，这里取一半）。
reserve_tokens = 200000
; 独立软阈值：0 = 只用「窗口 - 预留」（默认，触发线 80 万）；
; 想「每轮更轻」可显式调小（如 300000），代价是更早丢上下文。
compact_at_tokens = 0
; 压缩后保留的最近上下文（本地估算口径：UTF-8 字节 / 3）。
; 必须显著小于生效阈值，否则会退化成"压完只剩两三轮余量、每轮都要再压"
; （启动时会检查并夹到阈值的 1/3，日志里给出 warning）。
keep_recent_tokens = 60000
; 压缩收益下限：压完至少降低这个比例才提交，否则保持原历史并记录
; event=compaction_skipped reason=low_gain；0 表示不做收益判断。
min_gain_ratio = 0.3

[instructions]
; 终端 Agent 是否自动加载工作目录相关的 AGENTS.md。
agents_md = true
agents_md_file_name = AGENTS.md
; 是否向祖先目录查找；找到 .git 根后停止。
agents_md_search_parents = true
; 最多加载多少个文件。
agents_md_max_files = 8
; 单个文件与全部项目指令的最大字节数。
agents_md_max_file_bytes = 16384
agents_md_max_total_bytes = 32768
; 默认不跟随符号链接。
agents_md_follow_symlinks = false
; 没有 .git 根时最多向上查找的层数。
agents_md_max_depth = 16

[tools]
; 文件工具（read/write/edit）沙箱：默认只允许访问本次请求的工作目录
; 及其子目录，`../`、绝对路径与指向外部的符号链接都会被拒绝。
; 需要额外放行的目录用逗号分隔（相对路径相对工作目录解析）。
; 注意：bash 工具本身不受该限制。
; 设为 false 可完全关闭沙箱（不推荐）。
sandbox_enabled = true
sandbox_roots =

[storage]
; 用户级数据目录（权限等与用户相关的状态）。
; 留空时按 DE_HOME > XDG_DATA_HOME/de > ~/.de 解析；目录按需创建。
data_dir =
; 权限文件；留空时用 <data_dir>/permissions.json。
permissions_file =
; bash 命令白/黑名单文件；留空时用 <data_dir>/bash_policy.rules。
; 文件不存在时会自动生成一份带注释的默认规则，用户可直接编辑。
bash_policy_file =
; 项目信任文件；留空时用 <data_dir>/trust.json。
trust_file =

[permissions]
; 新路径（未单独配置）时的默认模式：confirm | workspace | full。
; 注意：confirm 的“逐次确认”通道尚未实现（M3），当前会先拒绝写/命令并提示。
default_mode = confirm
; 允许设置的最高模式；full 之外的档位不会被它限制。
max_mode = full
; 非交互调用方（A2A / 同步接口）允许的最高档位，且永远不会拿到 full。
non_interactive_max_mode = workspace
; 是否允许设置 full（false 时 full 会被夹到 workspace）。
allow_full_access = true
; 逐次确认的超时秒数；超时按拒绝处理。
approval_timeout_seconds = 120

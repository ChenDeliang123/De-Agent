#!/usr/bin/env bash
set -euo pipefail

# 解析真实脚本路径：支持软链到 PATH 后从任意目录调用。
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -L "${SCRIPT_SOURCE}" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "${SCRIPT_SOURCE}")" && pwd)"
  SCRIPT_SOURCE="$(readlink "${SCRIPT_SOURCE}")"
  case "${SCRIPT_SOURCE}" in
    /*) ;;
    *) SCRIPT_SOURCE="${SCRIPT_DIR}/${SCRIPT_SOURCE}" ;;
  esac
done
SELF_DIR="$(cd -P "$(dirname "${SCRIPT_SOURCE}")" && pwd)"

# ---------------------------------------------------------------------------
# 布局探测
#
# 支持三种布局，保证源码树开发与安装包/系统安装都能用：
#   1) source    源码树：<repo>/de，后端在 <repo>/build/aiagent_app
#      - 数据/日志仍留在仓库内（.runtime、build/db），保持开发体验不变。
#   2) package   便携包：包根/de，后端在 <pkg>/bin/aiagent_app
#   3) installed 系统安装：<prefix>/bin/de，后端在 <prefix>/bin/aiagent_app
#      - 2/3 的数据/日志落到用户数据目录（DE_HOME/XDG/HOME）。
# ---------------------------------------------------------------------------
BACKEND_BIN=""
LAYOUT=""
PREFIX=""
if [ -x "${SELF_DIR}/build/aiagent_app" ]; then
  LAYOUT="source"
  PREFIX="${SELF_DIR}"
  BACKEND_BIN="${SELF_DIR}/build/aiagent_app"
elif [ -x "${SELF_DIR}/bin/aiagent_app" ]; then
  LAYOUT="package"
  PREFIX="${SELF_DIR}"
  BACKEND_BIN="${SELF_DIR}/bin/aiagent_app"
elif [ -x "${SELF_DIR}/aiagent_app" ]; then
  LAYOUT="installed"
  PREFIX="$(cd -P "${SELF_DIR}/.." && pwd)"
  BACKEND_BIN="${SELF_DIR}/aiagent_app"
else
  # 后端尚未构建/安装：按目录结构推断布局，让 init/doctor 仍可用。
  if [ -d "${SELF_DIR}/conf" ] && [ -d "${SELF_DIR}/cli" ]; then
    LAYOUT="source"
    PREFIX="${SELF_DIR}"
    BACKEND_BIN="${SELF_DIR}/build/aiagent_app"
  elif [ -f "${SELF_DIR}/lib/de/cli/cli.mjs" ]; then
    LAYOUT="installed"
    PREFIX="$(cd -P "${SELF_DIR}/.." && pwd)"
    BACKEND_BIN="${SELF_DIR}/aiagent_app"
  elif [ -d "${SELF_DIR}/bin" ]; then
    LAYOUT="package"
    PREFIX="${SELF_DIR}"
    BACKEND_BIN="${SELF_DIR}/bin/aiagent_app"
  else
    echo "de: backend binary not found near ${SELF_DIR}" >&2
    echo "de: looked for build/aiagent_app, bin/aiagent_app, ./aiagent_app" >&2
    echo "de: build first (cmake --build build -j) or reinstall the package" >&2
    exit 1
  fi
fi

# 用户数据目录：与后端 ResolveAppPaths 保持一致（DE_HOME > XDG_DATA_HOME/de > ~/.de）。
resolve_data_dir() {
  if [ -n "${DE_HOME:-}" ]; then
    printf '%s' "${DE_HOME}"
  elif [ -n "${XDG_DATA_HOME:-}" ]; then
    printf '%s' "${XDG_DATA_HOME}/de"
  elif [ -n "${HOME:-}" ]; then
    printf '%s' "${HOME}/.de"
  else
    printf '%s' ""
  fi
}
DATA_DIR="$(resolve_data_dir)"

if [ "${LAYOUT}" = "source" ]; then
  CLI_DIR="${PREFIX}/cli"
  DEFAULT_CONFIG_FILE="${PREFIX}/conf/conf.ini"
  CLI_CONFIG_FILE="${PREFIX}/conf/cli.ini"
  DEFAULT_DB_PATH="${PREFIX}/build/db/aiagent_tasks.db"
  DEFAULT_RUNTIME_DIR="${PREFIX}/.runtime"
  SHARE_DIR="${PREFIX}/share/de"
  EXAMPLE_DIR="${PREFIX}/conf"
  LAUNCH_CWD="${PREFIX}"
else
  CLI_DIR="${PREFIX}/lib/de/cli"
  DEFAULT_CONFIG_FILE="${DATA_DIR}/conf/conf.ini"
  CLI_CONFIG_FILE="${DATA_DIR}/conf/cli.ini"
  DEFAULT_DB_PATH="${DATA_DIR}/aiagent_tasks.db"
  DEFAULT_RUNTIME_DIR="${DATA_DIR}/runtime"
  SHARE_DIR="${PREFIX}/share/de"
  EXAMPLE_DIR="${SHARE_DIR}/conf"
  LAUNCH_CWD="${DATA_DIR:-${PREFIX}}"
fi

RUNTIME_DIR="${AIAGENT_RUNTIME_DIR:-${DEFAULT_RUNTIME_DIR}}"
PID_FILE="${RUNTIME_DIR}/backend.pid"
LOG_FILE="${RUNTIME_DIR}/backend.log"
CONSOLE_LOG_FILE="${RUNTIME_DIR}/backend-console.log"

A2A_PORT="${AIAGENT_PORT:-18080}"
# 本地 HTTP 后端（终端 CLI 的通信端口）；保留 AIAGENT_WEB_PORT 兼容旧用法。
BACKEND_PORT="${AIAGENT_BACKEND_PORT:-${AIAGENT_WEB_PORT:-18081}}"
CONFIG_FILE="${AIAGENT_CONFIG:-${DEFAULT_CONFIG_FILE}}"
DB_PATH="${AIAGENT_DB:-${DEFAULT_DB_PATH}}"
LOG_LEVEL=""
LOG_FILE_ARG=""

ACTION="cli"
NO_BACKEND=0
CLI_ARGS=()

usage() {
  cat <<'EOF'
usage: de [command] [options]

commands:
  (no command)     ensure backend daemon is running, then start CLI
  stop             stop the daemonized backend
  status           show backend status
  restart          stop then start backend
  logs [target]    tail log: backend (default) | cli
  init             create user config from examples (non-destructive)
  doctor           check runtime environment and resolved paths
  help             show this help

options:
  --no-backend     only run CLI, do not start backend
  --a2a-port N     A2A port (default 18080)
  --backend-port N local backend API port for CLI (default 18081)
  --web-port N     alias of --backend-port (deprecated)
  --config FILE    DeepSeek config file
  --db FILE        SQLite database path
  --log-level N    backend log level (trace/debug/info/warn/error/fatal)
  --log-file FILE  backend structured log path
  --               pass remaining arguments to cli.mjs

environment:
  AIAGENT_PORT / AIAGENT_BACKEND_PORT / AIAGENT_CONFIG / AIAGENT_DB
  AIAGENT_WEB_PORT (deprecated alias of AIAGENT_BACKEND_PORT)
  AIAGENT_RUNTIME_DIR
  DE_HOME / XDG_DATA_HOME (用户数据目录，安装态下存放 db/log/conf)

layout: source | package | installed (auto-detected next to this script)
EOF
}

ensure_runtime_dir() {
  mkdir -p "${RUNTIME_DIR}"
}

health_check() {
  curl -sf "http://127.0.0.1:${BACKEND_PORT}/health" >/dev/null 2>&1
}

pid_alive() {
  local pid
  pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
  [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

# 按需创建用户配置（不覆盖已有文件）。源码树布局下写入仓库 conf/，
# 安装布局下写入 <data_dir>/conf/。
init_config() {
  mkdir -p "${DATA_DIR:-${PREFIX}}" "${RUNTIME_DIR}"
  local rc=0

  if [ -f "${CONFIG_FILE}" ]; then
    echo "config exists: ${CONFIG_FILE}"
  else
    mkdir -p "$(dirname "${CONFIG_FILE}")"
    if [ -f "${EXAMPLE_DIR}/app.ini.example" ]; then
      cp "${EXAMPLE_DIR}/app.ini.example" "${CONFIG_FILE}"
      echo "created ${CONFIG_FILE}"
      echo "  -> set [deepseek] api_key (or export DEEPSEEK_API_KEY)"
    else
      echo "de: example config not found: ${EXAMPLE_DIR}/app.ini.example" >&2
      rc=1
    fi
  fi

  if [ -f "${CLI_CONFIG_FILE}" ]; then
    echo "cli config exists: ${CLI_CONFIG_FILE}"
  else
    mkdir -p "$(dirname "${CLI_CONFIG_FILE}")"
    if [ -f "${EXAMPLE_DIR}/cli.ini.example" ]; then
      cp "${EXAMPLE_DIR}/cli.ini.example" "${CLI_CONFIG_FILE}"
      echo "created ${CLI_CONFIG_FILE}"
    fi
  fi

  echo
  echo "data dir:    ${DATA_DIR:-<none>}"
  echo "runtime dir: ${RUNTIME_DIR}"
  echo "next: fill api_key, then run 'de'"
  return ${rc}
}

port_in_use() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -E "[:.]${port}$" >/dev/null
  elif command -v netstat >/dev/null 2>&1; then
    netstat -ltn 2>/dev/null | awk '{print $4}' | grep -E "[:.]${port}$" >/dev/null
  else
    (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null
  fi
}

DOCTOR_FAILURES=0
doctor_check() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf '  ok    %s\n' "${label}"
  else
    printf '  FAIL  %s\n' "${label}"
    DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1))
  fi
}

doctor() {
  DOCTOR_FAILURES=0
  echo "de doctor"
  echo "  layout:      ${LAYOUT}"
  echo "  prefix:      ${PREFIX}"
  echo "  backend:     ${BACKEND_BIN}"
  echo "  cli dir:     ${CLI_DIR}"
  echo "  share dir:   ${SHARE_DIR}"
  echo "  data dir:    ${DATA_DIR:-<none>}"
  echo "  runtime dir: ${RUNTIME_DIR}"
  echo "  config:      ${CONFIG_FILE}"
  echo "  db:          ${DB_PATH}"
  echo

  doctor_check "backend binary" test -x "${BACKEND_BIN}"
  doctor_check "cli entry" test -f "${CLI_DIR}/cli.mjs"
  doctor_check "config file" test -f "${CONFIG_FILE}"

  if command -v node >/dev/null 2>&1; then
    printf '  ok    node: %s\n' "$(node --version 2>/dev/null)"
  else
    echo "  FAIL  node not found (>= 18 required)"
    DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1))
  fi

  if command -v curl >/dev/null 2>&1; then
    echo "  ok    curl"
  else
    echo "  warn  curl not found; 'de status/start' health check needs it"
  fi

  if [ -n "${DATA_DIR:-}" ] && mkdir -p "${DATA_DIR}" 2>/dev/null && [ -w "${DATA_DIR}" ]; then
    echo "  ok    data dir writable"
  else
    echo "  FAIL  data dir not writable: ${DATA_DIR:-<none>}"
    DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1))
  fi

  local port
  for port in "${A2A_PORT}" "${BACKEND_PORT}"; do
    if port_in_use "${port}"; then
      echo "  warn  port ${port} already in use"
    else
      echo "  ok    port ${port} free"
    fi
  done

  echo
  if [ "${DOCTOR_FAILURES}" -gt 0 ]; then
    echo "doctor: ${DOCTOR_FAILURES} critical problem(s) found"
    return 1
  fi
  echo "doctor: all critical checks passed"
  return 0
}

stop_backend() {
  ensure_runtime_dir
  if [ -f "${PID_FILE}" ]; then
    local pid
    pid="$(cat "${PID_FILE}")"
    if kill -0 "${pid}" 2>/dev/null; then
      echo "stopping backend (pid ${pid})..."
      kill -TERM "${pid}" 2>/dev/null || true
      for _ in $(seq 1 40); do
        if ! kill -0 "${pid}" 2>/dev/null; then
          break
        fi
        sleep 0.25
      done
      if kill -0 "${pid}" 2>/dev/null; then
        kill -KILL "${pid}" 2>/dev/null || true
      fi
    else
      echo "removing stale pid file"
    fi
    rm -f "${PID_FILE}"
    return 0
  fi

  if health_check; then
    echo "backend is running but not managed by de; stop it in its own terminal"
  else
    echo "backend is not running"
  fi
}

start_backend() {
  ensure_runtime_dir

  if [ ! -f "${CONFIG_FILE}" ]; then
    echo "de: config file not found: ${CONFIG_FILE}" >&2
    echo "de: copy ${SHARE_DIR}/conf/app.ini.example to ${CONFIG_FILE} and fill api_key" >&2
    return 1
  fi

  if health_check; then
    echo "backend already running on http://127.0.0.1:${BACKEND_PORT}"
    return 0
  fi

  if [ -f "${PID_FILE}" ] && pid_alive; then
    echo "waiting for backend to become healthy..."
    for _ in $(seq 1 40); do
      if health_check; then
        echo "backend already running on http://127.0.0.1:${BACKEND_PORT}"
        return 0
      fi
      sleep 0.25
    done
    echo "backend pid is alive but not healthy; restarting it" >&2
    stop_backend
  fi

  if [ ! -x "${BACKEND_BIN}" ]; then
    echo "backend binary not found: ${BACKEND_BIN}" >&2
    echo "build it first with: cmake --build build -j" >&2
    return 1
  fi

  rm -f "${PID_FILE}"
  echo "starting backend daemon (console log: ${CONSOLE_LOG_FILE})..."
  local backend_args=(
    "${BACKEND_BIN}"
    --config "${CONFIG_FILE}"
    --db "${DB_PATH}"
    --port "${A2A_PORT}"
    --web-port "${BACKEND_PORT}"
    --log-file "${LOG_FILE_ARG:-${LOG_FILE}}"
  )
  if [ -n "${LOG_LEVEL}" ]; then
    backend_args+=(--log-level "${LOG_LEVEL}")
  fi
  mkdir -p "${LAUNCH_CWD}"
  (
    cd "${LAUNCH_CWD}"
    nohup "${backend_args[@]}" >>"${CONSOLE_LOG_FILE}" 2>&1 &
    echo $! >"${PID_FILE}"
  )

  for _ in $(seq 1 120); do
    if health_check; then
      echo "backend ready on http://127.0.0.1:${BACKEND_PORT}"
      return 0
    fi
    if ! pid_alive; then
      break
    fi
    sleep 0.5
  done

  echo "backend failed to become healthy; last console log:" >&2
  tail -n 20 "${CONSOLE_LOG_FILE}" >&2 || true
  echo "structured backend log:" >&2
  tail -n 20 "${LOG_FILE}" >&2 || true
  return 1
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    stop)
      ACTION="stop"
      shift
      ;;
    status)
      ACTION="status"
      shift
      ;;
    restart)
      ACTION="restart"
      shift
      ;;
    logs)
      ACTION="logs"
      shift
      ;;
    init)
      ACTION="init"
      shift
      ;;
    doctor|check)
      ACTION="doctor"
      shift
      ;;
    help|--help|-h)
      ACTION="help"
      shift
      ;;
    --no-backend)
      NO_BACKEND=1
      shift
      ;;
    --a2a-port)
      A2A_PORT="$2"
      shift 2
      ;;
    --backend-port|--web-port)
      BACKEND_PORT="$2"
      shift 2
      ;;
    --config)
      CONFIG_FILE="$2"
      shift 2
      ;;
    --db)
      DB_PATH="$2"
      shift 2
      ;;
    --log-level)
      LOG_LEVEL="$2"
      shift 2
      ;;
    --log-file)
      LOG_FILE_ARG="$2"
      shift 2
      ;;
    --)
      shift
      CLI_ARGS+=("$@")
      break
      ;;
    *)
      CLI_ARGS+=("$1")
      shift
      ;;
  esac
done

case "${ACTION}" in
  help)
    usage
    ;;
  status)
    ensure_runtime_dir
    if health_check; then
      if [ -f "${PID_FILE}" ]; then
        echo "running (pid $(cat "${PID_FILE}")) on http://127.0.0.1:${BACKEND_PORT}"
      else
        echo "running (external) on http://127.0.0.1:${BACKEND_PORT}"
      fi
    else
      echo "stopped"
    fi
    ;;
  stop)
    stop_backend
    ;;
  restart)
    stop_backend
    start_backend
    ;;
  init)
    init_config
    ;;
  doctor)
    doctor
    ;;
  logs)
    ensure_runtime_dir
    target="backend"
    if [ "${#CLI_ARGS[@]}" -gt 0 ]; then
      target="${CLI_ARGS[0]}"
    fi
    case "${target}" in
      backend)
        LOG_TARGET="${LOG_FILE}"
        ;;
      cli)
        LOG_TARGET="${RUNTIME_DIR}/cli.log"
        ;;
      *)
        echo "unknown log target: ${target}; use backend|cli" >&2
        exit 1
        ;;
    esac
    touch "${LOG_TARGET}" 2>/dev/null || true
    tail -f "${LOG_TARGET}"
    ;;
  cli)
    if [ "${NO_BACKEND}" -eq 0 ]; then
      start_backend
    fi

    NODE_BIN="${NODE_BIN:-$(command -v node)}"
    if [ -z "${NODE_BIN}" ]; then
      echo "node not found; install Node.js >= 18" >&2
      exit 1
    fi

    cli_extra=()
    if [ -f "${CLI_CONFIG_FILE}" ]; then
      cli_extra+=(--cli-config "${CLI_CONFIG_FILE}")
    fi

    echo "starting CLI (backend http://127.0.0.1:${BACKEND_PORT})..."
    AIAGENT_RUNTIME_DIR="${RUNTIME_DIR}" \
    AIAGENT_SHARE_DIR="${SHARE_DIR}" \
    "${NODE_BIN}" "${CLI_DIR}/cli.mjs" \
      --backend "http://127.0.0.1:${BACKEND_PORT}" \
      "${cli_extra[@]}" \
      "${CLI_ARGS[@]}"
    cli_status=$?

    echo
    echo "CLI exited. Backend is still running; use 'de stop' to stop it."
    exit "${cli_status}"
    ;;
esac
